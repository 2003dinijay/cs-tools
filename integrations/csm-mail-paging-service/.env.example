# Google service account key (JSON, one line) with domain-wide delegation for
# https://www.googleapis.com/auth/gmail.modify
GMAIL_SERVICE_ACCOUNT_JSON=
# Mailbox the service account acts as; it must be a member of the watched group.
GMAIL_DELEGATED_USER=
# Optional
GMAIL_PROCESSED_LABEL=csm-mail-paging-processed
MAIL_POLL_INTERVAL=30s
MAIL_LOOKBACK=2d

# One entry per watched address. recipient is the group address.
MAIL_TRIGGER_RULES=[{"name":"example","recipient":"group@example.com","senderRegex":"","eventType":"mail.alert.received","levels":3,"callPath":[{"level":2,"to":["+15550100"]},{"level":3,"to":["+15550101"]}],"levelDelaySeconds":300}]

# Twilio (same variables as csm-notification-service). Required only when a
# rule has a callPath. TWILIO_FROM_NUMBER is the caller ID (E.164).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: text-to-speech voice/locale, ring time, API base override.
TWILIO_VOICE=
TWILIO_LANGUAGE=
TWILIO_RING_TIMEOUT_SECONDS=
TWILIO_API_BASE_URL=
# Set to false to publish events but place no calls.
CALL_SENDING_ENABLED=true

EVENT_BUS_BROKER=
EVENT_BUS_CONNECTION_STRING=
EVENT_BUS_TOPIC=
